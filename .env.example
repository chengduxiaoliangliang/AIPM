# ── AIPM environment template ────────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Application
ENV=production
DEBUG=false
PROJECT_NAME=AIPM - 智能项目管理系统
API_V1_STR=/api/v1

# MySQL (host = "mysql" when running via docker compose)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=aipm
MYSQL_PASSWORD=change-me
MYSQL_DB=aipm_db
MYSQL_ROOT_PASSWORD=change-me-too

# Redis (host = "redis" when running via docker compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# JWT — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# DeepSeek / LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
AI_ENABLED=true

# AI session limits
AI_SESSION_TTL=604800
AI_MAX_HISTORY_TURNS=20
AI_MAX_SESSIONS_PER_USER=10

# CORS — comma-separated origins, or "*" for any (credentials auto-disabled)
BACKEND_CORS_ORIGINS=*
